{
  "name": "trip-flight-tool",
  "version": "0.1.0",
  "description": "Trip.com browser flight search for agents and DeepSeek Harness",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "trip-flight": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "tests",
    "README.md",
    "docs",
    "integrations",
    "trip-flight.cmd"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "data:update": "node scripts/update-airports.mjs",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/cli.js",
    "mcp": "node dist/mcp/server.js",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "smoke:dsh": "node scripts/dsh-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.64.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "csv-parse": "7.0.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
