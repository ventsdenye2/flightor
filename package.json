{
  "name": "flightor",
  "version": "1.0.0",
  "private": true,
  "description": "FlightOR — 长程套利路由专家（微信小程序）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "node scripts/build-weapp.cjs",
    "build:weapp:local": "node scripts/build-local-weapp.cjs",
    "build:h5": "taro build --type h5",
    "build:h5:local": "node scripts/build-local-h5.cjs",
    "build:h5:replay": "node scripts/build-replay-h5.cjs",
    "dev:h5": "taro build --type h5 --watch",
    "serve:h5": "node scripts/serve-h5.cjs",
    "qa:h5": "node scripts/qa-h5.cjs",
    "qa:weapp-ui": "node scripts/qa-weapp-ui.cjs",
    "test:weapp-build-info": "node scripts/test-weapp-build-info.cjs",
    "dev:weapp": "npm run build:weapp -- --watch",
    "gen:icons": "node scripts/gen-icons.js",
    "gen:guides": "node scripts/gen-guides.js",
    "test": "npm run test:weapp-build-info && npm run test:budget && npm run test:chat-history && npm run test:phase5-client && npm run test:conversation-progress && npm run test:session-recovery && npm run test:trip-context-chips && npm run test:artifacts && npm run test:route-page-dispatch && npm run test:route-ui-polish && npm run test:flight-connections && npm run test:airport-times && npm run test:phase6-client && npm run test:phase789-client && npm run test:oag && npm run test:connectivity && npm run test:route && npm run test:route-real && npm run test:route-llm && npm run test:route-cloud && npm run test:production-presentation",
    "test:budget": "node scripts/test-budget.cjs",
    "test:trip-context-chips": "node scripts/test-trip-context-chips.js",
    "test:chat-history": "node scripts/test-chat-history.js",
    "test:phase5-client": "node scripts/test-phase5-client.js",
    "test:conversation-progress": "node scripts/test-conversation-progress.js && node src/components/plan/PlannerProgress.test.cjs && npm run test:planner-publication",
    "test:planner-publication": "node scripts/test-planner-publication.cjs && node scripts/test-plan-flight-publication.cjs",
    "test:planner-reply": "node scripts/test-planner-reply.cjs",
    "test:session-recovery": "node scripts/test-session-recovery.js",
    "test:artifacts": "node scripts/test-artifacts.js",
    "test:route-page-dispatch": "node scripts/test-route-page-dispatch.cjs",
    "test:route-ui-polish": "node scripts/test-route-ui-polish.cjs",
    "test:flight-connections": "node scripts/test-flight-connections.js",
    "test:airport-times": "node scripts/test-airport-times.js",
    "test:phase6-client": "node scripts/test-phase6-client.js",
    "test:oag": "node scripts/test-oag.js",
    "test:connectivity": "node scripts/test-connectivity.js",
    "test:route": "node scripts/test-route.js",
    "test:route-real": "node scripts/test-route-real.js",
    "test:route-llm": "node scripts/test-route-llm.js",
    "test:route-cloud": "node scripts/test-route-cloud.js",
    "backend:check": "npm --prefix backend run check",
    "backend:test": "npm --prefix backend test",
    "backend:build": "npm --prefix backend run build",
    "backend:migrate": "npm --prefix backend run migrate",
    "backend:up": "docker compose up -d --build",
    "backend:down": "docker compose down",
    "test:phase789-client": "node scripts/test-phase789-client.js",
    "admin:dev": "npm --prefix apps/admin run dev",
    "admin:build": "npm --prefix apps/admin run build",
    "test:production-presentation": "node scripts/test-production-presentation.cjs && npm run test:planner-reply && node scripts/test-production-library.cjs"
  },
  "overrides": {
    "webpack": "5.78.0"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@tarojs/components": "~3.6.25",
    "@tarojs/helper": "~3.6.25",
    "@tarojs/plugin-framework-react": "~3.6.25",
    "@tarojs/plugin-platform-h5": "3.6.40",
    "@tarojs/plugin-platform-weapp": "~3.6.25",
    "@tarojs/react": "~3.6.25",
    "@tarojs/router": "3.6.40",
    "@tarojs/runtime": "~3.6.25",
    "@tarojs/shared": "~3.6.25",
    "@tarojs/taro": "~3.6.25",
    "@tarojs/taro-h5": "3.6.40",
    "mobx": "^6.12.0",
    "mobx-react-lite": "^4.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.5",
    "@tarojs/cli": "~3.6.25",
    "@tarojs/taro-loader": "~3.6.25",
    "@tarojs/webpack5-runner": "~3.6.25",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "~3.6.25",
    "playwright": "1.63.0",
    "sass": "^1.60.0",
    "typescript": "^5.1.0",
    "webpack": "5.78.0"
  }
}
