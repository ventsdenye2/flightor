{
  "name": "flightor",
  "version": "1.0.0",
  "private": true,
  "description": "FlightOR shared frontend for a new backend MVP: WeChat Mini Program and H5",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "backend:setup": "npm --prefix backend ci && node backend/scripts/copy-dsh.mjs && node backend/scripts/prepare-dsh.mjs",
    "backend:start": "npm --prefix backend start",
    "backend:test": "npm --prefix backend test",
    "backend:live": "node backend/scripts/run-live.mjs",
    "setup": "npm ci && npm --prefix apps/ui-preview ci",
    "dev": "npm run dev:h5",
    "dev:h5": "npm --prefix apps/ui-preview run dev",
    "dev:weapp": "node scripts/build-ui-experience.cjs --watch",
    "build:h5": "npm --prefix apps/ui-preview run build",
    "build:weapp": "node scripts/build-ui-experience.cjs",
    "build": "npm run build:h5 && npm run build:weapp",
    "check:weapp": "tsc -p apps/ui-preview/taro-entry/tsconfig.json --noEmit",
    "check": "npm run check:weapp && npm --prefix apps/ui-preview run check",
    "test": "node scripts/check-ui-presentation.cjs && node scripts/check-ui-flight-samples.cjs && node scripts/check-flight-options.cjs && node scripts/check-world-flight.cjs && node scripts/test-dsh-client.cjs && node scripts/test-session-context.cjs && node scripts/test-chat-markdown.cjs",
    "check:docs": "node scripts/check-docs.cjs"
  },
  "overrides": {
    "webpack": "5.78.0"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@tarojs/components": "~3.6.25",
    "@tarojs/helper": "~3.6.25",
    "@tarojs/plugin-framework-react": "~3.6.25",
    "@tarojs/plugin-platform-weapp": "~3.6.25",
    "@tarojs/react": "~3.6.25",
    "@tarojs/runtime": "~3.6.25",
    "@tarojs/shared": "~3.6.25",
    "@tarojs/taro": "~3.6.25",
    "entities": "9.0.0",
    "marked": "18.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.5",
    "@tarojs/cli": "~3.6.25",
    "@tarojs/taro-loader": "~3.6.25",
    "@tarojs/webpack5-runner": "~3.6.25",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "~3.6.25",
    "sass": "^1.60.0",
    "typescript": "^5.1.0",
    "webpack": "5.78.0"
  },
  "engines": {
    "node": ">=22.21.0 <23",
    "npm": ">=10 <11"
  }
}
