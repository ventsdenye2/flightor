# Obtain an access_token with your Wikimedia Enterprise account. Backend only.
WIKIMEDIA_ENTERPRISE_ACCESS_TOKEN=
WIKIMEDIA_ENTERPRISE_ID_TOKEN=
WIKIMEDIA_ENTERPRISE_REFRESH_TOKEN=
WIKIMEDIA_ENTERPRISE_USERNAME=
# Optional contact-bearing User-Agent for Wikimedia requests.
# FLIGHTOR_WIKIMEDIA_USER_AGENT=FlightOR/0.1 (your contact URL or email)
# Optional alternative absolute path to a rebuilt offline index.
# FLIGHTOR_GEO_INDEX=
