NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://flightor:flightor_dev@localhost:5432/flightor
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Generate a long random value for every environment. Never commit the real value.
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_API_TOKEN=

WX_APPID=
WX_SECRET=

# Optional developer-tools login. Requires non-production NODE_ENV and loopback HOST.
# Use `npm run local-login:setup` in backend to configure the ignored .env.demo.
LOCAL_LOGIN_ENABLED=false
LOCAL_LOGIN_KEY=

# Primary aviation-data provider. Leave the key empty for local/mock tests.
AERODATABOX_API_KEY=
AERODATABOX_BASE_URL=https://aerodatabox.p.rapidapi.com

# Optional aviation enhancement/fallback. Core Agent tests do not require OAG.
OAG_FLIGHT_INFO_KEY=
OAG_CONNECTIONS_KEY=
OAG_SCHEDULES_KEY=
OAG_MASTER_DATA_KEY=
OAG_BASE_URL=https://api.oag.com
OAG_SCHEDULES_PATH=/flights
OAG_CONNECTIONS_PATH=/flight-connections
OAG_LOCATIONS_PATH=/locations
OAG_FLIGHT_INFO_PATH=/flight-instances/

SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
PLANNER_MODEL=
FLIGHTOR_AGENT_ENGINE=legacy
DSH_MODEL_PROVIDER=openrouter
DSH_MODEL=
DSH_SEARCH_PROVIDER=serpapi-raw
DSH_DATA_DIRECTORY=.dsh-data
DSH_MAX_ACTIVE=4
DSH_IDLE_MS=120000
DSH_AUTHORIZED_USD=0
DSH_AUTHORIZED_MODEL_CALLS=0
DSH_AUTHORIZED_SEARCH_CALLS=0
DSH_BUDGET_PATH=.dsh-data/budget.json
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_SEARCH_API_KEY=
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash
# Opt in to business-tool Goal acceptance; false restores the legacy Goal tools.
PLANNER_LEAN_GOALS_ENABLED=false
RESEARCH_MODEL=

# Opt-in native web research. The default keeps SerpApi + synthesis. A shared
# USD budget record must be provisioned in PostgreSQL before selecting native;
# zero (the default) rejects the call without contacting a provider.
NATIVE_RESEARCH_PROVIDER=serpapi
NATIVE_RESEARCH_MODEL=qwen/qwen3.8-flash
NATIVE_RESEARCH_BUDGET_ID=
NATIVE_RESEARCH_MAX_CALL_USD_MICROS=0
NATIVE_RESEARCH_TIMEOUT_MS=95000

# Optional server-only proxy for Nominatim; Node 22.21+ / 24.5+.
# Empty preserves default fetch. Never include this URL in frontend configuration.
PLACES_PROXY_URL=

# Wikimedia photos: blank UA disables explicit completion; saved photos remain readable.
# Use a real application/contact identifier. Free API, no image-search key.
MEDIA_USER_AGENT=
# Optional trusted request-only HTTP(S) CONNECT proxy, Node 22.21+ / 24.5+.
MEDIA_PROXY_URL=
